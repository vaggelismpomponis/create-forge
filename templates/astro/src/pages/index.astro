---
import { ShieldCheck, Terminal, Compass } from "lucide-react";
import { ModalDemo } from "../components/ModalDemo";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Production Architecture | Astro Blueprint</title>
  </head>
  <body class="bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 min-h-dvh flex flex-col font-sans">
    <main class="w-full max-w-4xl mx-auto px-4 py-8 md:py-16 flex-1 flex flex-col">
      <header class="mb-10 text-left">
        <p class="text-xs font-semibold tracking-widest uppercase text-zinc-500 mb-2">
          Content-First Architecture
        </p>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Astro Production Blueprint
        </h1>
        <p class="mt-3 text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl">
          Zero-runtime JS baseline, optimal Core Web Vitals, semantic single H1 hierarchy, and anti-slop design.
        </p>
      </header>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <div class="border border-zinc-200 dark:border-zinc-800 rounded-lg p-5 bg-zinc-50/50 dark:bg-zinc-900/50">
          <div class="flex items-center gap-2 mb-2 text-zinc-900 dark:text-zinc-100 font-semibold">
            <ShieldCheck className="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
            <span>8 Active Engineering Skills</span>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Strict engineering standards baked into <code class="text-xs bg-zinc-200 dark:bg-zinc-800 px-1 py-0.5 rounded">.agent/skills</code> and <code class="text-xs bg-zinc-200 dark:bg-zinc-800 px-1 py-0.5 rounded">AGENTS.md</code>.
          </p>
        </div>

        <div class="border border-zinc-200 dark:border-zinc-800 rounded-lg p-5 bg-zinc-50/50 dark:bg-zinc-900/50">
          <div class="flex items-center gap-2 mb-2 text-zinc-900 dark:text-zinc-100 font-semibold">
            <Terminal className="w-5 h-5 text-blue-600 dark:text-blue-400" />
            <span>Sub-Millisecond Linter</span>
          </div>
          <p class="text-sm text-zinc-600 dark:text-zinc-400">
            Powered by Biome for rapid format and lint verification.
          </p>
        </div>
      </div>

      <div class="border-t border-zinc-200 dark:border-zinc-800 pt-8">
        <ModalDemo client:load />
      </div>
    </main>
  </body>
</html>
