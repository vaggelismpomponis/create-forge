{
  "name": "create-forge",
  "version": "1.0.0",
  "description": "Modern CLI to scaffold apps and websites preconfigured with strict production engineering standards and AI skills",
  "type": "module",
  "bin": {
    "create-forge": "./dist/index.js",
    "forge": "./dist/index.js"
  },
